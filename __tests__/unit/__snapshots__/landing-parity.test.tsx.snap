al-white)] py-[3px] pr-[3px] pl-[23px] text-base leading-6 font-bold whitespace-nowrap text-[var(--color-primary-core)] transition-[color,scale] duration-150 ease-out hover:text-[var(--color-primary-hover)] active:scale-[0.96]" href="/sign-up?role=student">Get Started<span aria-hidden="true" class="flex size-10 shrink-0 items-center justify-center rounded-full bg-[var(--color-primary-core)]"><span aria-hidden="true" class="size-3.5 shrink-0 [mask:url(/assets/ic/ic-arrow-up.png)_center/contain_no-repeat] bg-[var(--color-neutral-white)]"></span></span></a></div></div></div></div><div class="relative mx-auto w-full max-w-[77.5rem] px-6 pt-16 pb-12 sm:pt-20 lg:pt-[120px]"><div class="grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-[24rem_auto_auto_auto] lg:justify-between lg:gap-x-10"><div class="flex flex-col gap-4"><a class="inline-block shrink-0" href="/"><img src="/assets/ic-demo/Icon-blue.png" alt="Masters Hub" class="aspect-[860/220] h-14 w-auto" width="860" height="220" data-testid="next-image"/></a><p class="text-sm leading-relaxed text-pretty text-[var(--color-text-secondary)] sm:text-base">Masters Hub is Bangladesh&#x27;s trusted platform connecting students and guardians with verified, top-tier academic tutors for school, college, and test prep.</p><div class="flex flex-col gap-1.5 text-sm text-[var(--color-text-secondary)]"><p class="text-base leading-6 text-[var(--color-neutral-charcoal)]"><span class="font-semibold">Corporate Office:</span> House 42, Road 11, Block D, Banani, Dhaka 1213, Bangladesh</p><p class="flex flex-col text-base leading-[27px] text-[var(--color-neutral-charcoal)]"><span class="text-lg font-semibold">Phone:</span> +880 1700-000000</p><p><span class="text-lg font-semibold">Email:</span> support@mastershub.com</p></div></div><div class="flex flex-col gap-[13px]"><h3 class="text-xl leading-7 font-bold text-[var(--color-neutral-charcoal)]">Quick Links</h3><ul class="flex flex-col gap-[13px]"><li><a class="text-base leading-6 text-[var(--color-text-secondary)] transition-colors duration-150 hover:text-[var(--color-primary-core)]" href="/#tutors">Find a Tutor</a></li><li><a class="text-base leading-6 text-[var(--color-text-secondary)] transition-colors duration-150 hover:text-[var(--color-primary-core)]" href="/#categories">Subject Categories</a></li><li><a class="text-base leading-6 text-[var(--color-text-secondary)] transition-colors duration-150 hover:text-[var(--color-primary-core)]" href="/#how-it-works">How It Works</a></li><li><a class="text-base leading-6 text-[var(--color-text-secondary)] transition-colors duration-150 hover:text-[var(--color-primary-core)]" href="/#categories">Tuition Packages</a></li><li><a class="text-base leading-6 text-[var(--color-text-secondary)] transition-colors duration-150 hover:text-[var(--color-primary-core)]" href="/#faq">Frequently Asked Questions</a></li></ul></div><div class="flex flex-col gap-2"><h3 class="text-xl leading-7 font-bold text-[var(--color-neutral-charcoal)]">For Tutors</h3><ul class="flex flex-col gap-2"><li><a class="text-sm text-[var(--color-text-secondary)] transition-colors duration-150 hover:text-[var(--color-primary-core)] sm:text-base" href="/#how-it-works">Become a Tutor</a></li><li><a class="text-sm text-[var(--color-text-secondary)] transition-colors duration-150 hover:text-[var(--color-primary-core)] sm:text-base" href="/#faq">Tutor Guidelines</a></li><li><a class="text-sm text-[var(--color-text-secondary)] transition-colors duration-150 hover:text-[var(--color-primary-core)] sm:text-base" href="/#faq">Verification Process</a></li><li><a class="text-sm text-[var(--color-text-secondary)] transition-colors duration-150 hover:text-[var(--color-primary-core)] sm:text-base" href="/#faq">Code of Conduct</a></li><li><a class="text-sm text-[var(--color-text-secondary)] transition-colors duration-150 hover:text-[var(--color-primary-core)] sm:text-base" href="/#tutors">Tuition Opportunities</a></li></ul></div><div class="flex flex-col gap-3