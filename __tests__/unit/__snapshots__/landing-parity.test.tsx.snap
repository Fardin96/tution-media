-auto w-5" width="86" height="82" data-testid="next-image"/><span class="text-primary-900 text-base leading-[1.5] font-normal">Your #1 Platform for Tutors</span></div><h1 class="mt-4 max-w-4xl text-4xl font-semibold tracking-tight text-[var(--color-neutral-charcoal)] sm:text-5xl md:text-6xl lg:text-7xl">Find the right tutor, faster.</h1><p class="mt-4 max-w-xl text-lg text-[var(--color-neutral-gray)]">A smarter way to connect students and tutors—built for clarity, trust, and real results.</p><div class="@container w-full max-w-[640px] mt-[37px]"><form role="search" class="border-chip-border @xl:rounded-chip relative flex flex-col gap-1 rounded-[var(--border-radius-24)] border bg-white p-1.5 shadow-[0_8px_24px_rgba(0,0,0,0.06)] focus-within:ring-2 focus-within:ring-[var(--color-primary-core)]/30 @xl:flex-row @xl:items-center" action="/tutors" method="get"><div class="flex min-h-12 flex-1 items-center gap-2 ps-4 pe-2 @xl:relative"><img src="/assets/ic/ic-search.png" alt="" width="20" height="20" data-testid="next-image"/><div class="relative h-12 min-w-0 flex-1 overflow-hidden"><canvas aria-hidden="true" class="pointer-events-none absolute top-[20%] left-0 origin-top-left scale-50 opacity-0"></canvas><input role="combobox" aria-autocomplete="list" aria-expanded="false" type="search" aria-label="Subject" class="relative z-10 h-full w-full bg-transparent text-base text-[var(--color-neutral-charcoal)] outline-none [&amp;::-webkit-search-cancel-button]:hidden" name="q" value=""/><div class="pointer-events-none absolute inset-0 flex items-center"><p aria-hidden="true" class="w-full truncate text-start text-base text-[var(--color-neutral-gray)]" style="opacity:1;transform:none">e.g. Mathematics</p></div></div><span aria-live="polite" class="sr-only"></span></div><div class="flex min-h-12 flex-1 items-center gap-2 ps-4 pe-2 @xl:relative border-chip-border border-t @xl:border-s @xl:border-t-0"><img src="/assets/ic/ic-pin-map.png" alt="" width="72" height="82" class="h-5 w-aut